#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

fail=0

check() {
  local label="$1" cmd="$2"
  if eval "$cmd" >/dev/null 2>&1; then
    printf '  ok    %s\n' "$label"
  else
    printf '  FAIL  %s\n' "$label"
    fail=1
  fi
}

printf 'AIH doctor\n'
printf '%s\n' '----------'

check "node >= 20"            "node -e 'process.exit(Number(process.versions.node.split(\".\")[0]) >= 20 ? 0 : 1)'"
check "npm available"         "command -v npm"
check "APP.md present"        "test -f APP.md"
check "harness.yml present"   "test -f harness.yml"
check "task template present" "test -f tasks/TEMPLATE.md"
check "decisions log present" "test -f docs/decisions.md"
check "core sources present"  "test -f core/src/agent-loop.ts"
check "mcp-server present"    "test -f mcp-server/src/index.ts"
check "skill present"         "test -f skills/aih-app-integration/SKILL.md"

if [ -d node_modules ]; then
  check "dependencies installed" "test -d node_modules/@modelcontextprotocol/sdk"
else
  printf '  warn  dependencies not installed yet (run: npm run bootstrap)\n'
fi

# CC#59 — credential-scope self check: a provider secret must only ever ride to
# its own host. If an Authorization/api-key header would be sent to a different
# host (e.g. after AIH_BASE_URL / --base-url override), the leak guard must drop
# it. The check below builds a mismatch and asserts the sensitive header is gone.
check "credential scope: leak guard drops secrets on host mismatch" "node -e 'const {credentialSafeHeaders}=require(\"./cli/dist/config.js\");const r=credentialSafeHeaders({authorization:\"Bearer X\",\"x-api-key\":\"k\",\"user-agent\":\"aih\"},\"https://api.anthropic.com/v1\",\"https://evil.example.com/v1\");if(\"authorization\" in r||\"x-api-key\" in r) process.exit(1);if(r[\"user-agent\"]!==\"aih\") process.exit(2)'"
printf '  credential scope: providers → own host only (leak guard active)\n'

# OC#7 — credential ownership isolation: a provider failure must degrade ITS OWNER
# (recorded, redacted) and the reason must never contain a raw secret.
check "owner isolation: owner-state module wired (redact + degrade)" "node -e 'const m=require(\"./cli/dist/owner-state.js\");const r=m.redactCredential(\"HTTP 401 Bearer sk-abcdef1234567890 owner=empero\");if(r.includes(\"sk-abcdef1234567890\")) process.exit(1);if(!r.includes(\"[redacted]\")) process.exit(2);if(typeof m.markOwnerDegraded!==\"function\") process.exit(3)'"
printf '  owner isolation: credential failures degrade their owner (no fallback)\n'